# Used by docker-compose.yml. Copy to .env and fill in real values. Never commit .env.
POSTGRES_DB=certifix
POSTGRES_USER=certifix
POSTGRES_PASSWORD=CHANGE_ME
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ENVIRONMENT=production
# Public URL of the site (used for CORS and the QR verification links printed on certificates)
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
MAX_UPLOAD_MB=10
UPLOAD_RETENTION_DAYS=180
